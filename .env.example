# =============================================================================
# SDLC Platform — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is excluded by .gitignore.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=sdlc_db
POSTGRES_USER=sdlc_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ── Backend / Spring Boot ───────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sdlc_db
DB_USERNAME=sdlc_user
DB_PASSWORD=change_me_in_production
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# ── JWT (Phase 1) ───────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRATION_MS=86400000

# ── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8081/api/v1
FRONTEND_PORT=3000

# ── Docker port overrides (optional) ────────────────────────────────────────
BACKEND_PORT=8080
